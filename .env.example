# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ZILLOW_MCP_SERVER_URL: Optional Zillow MCP Server Endpoint (JSON-RPC/SSE/REST)
# Defaults to integrated MCP adapter with development real-estate database if empty
ZILLOW_MCP_SERVER_URL=""

# DATABASE_URL: PostgreSQL (PostGIS) connection for the dashboard API.
# Local peer-auth default: postgresql://jacen@/jacen_dev?host=/var/run/postgresql
DATABASE_URL=""

# DASHBOARD_AUTH_USER / DASHBOARD_AUTH_PASSWORD: Optional HTTP Basic Auth for the dashboard and dashboard API.
# Configure both together. When exposed beyond localhost, terminate HTTPS in front of the app.
DASHBOARD_AUTH_USER=""
DASHBOARD_AUTH_PASSWORD=""
