# Canonical product: Jackson County Property Intelligence
# DashboardApp → createApp() → Postgres/PostGIS → api.dashboard_*

# Required for the dashboard API.
# Local peer-auth default: postgresql://jacen@/jacen_dev?host=/var/run/postgresql
DATABASE_URL=""

# Required in NODE_ENV=production. Configure both together, or set API_KEY.
# Production refuses to start if neither pair is present.
DASHBOARD_AUTH_USER=""
DASHBOARD_AUTH_PASSWORD=""

# Optional shared gate accepted via X-Api-Key on the same-origin API.
# Never set VITE_API_KEY for a GitHub Pages build.
API_KEY=""

# Optional public API origin for the Pages shell only. Not a PII credential.
VITE_API_BASE_URL=""

# Comma-separated extra browser origins. github.io and localhost are already allowed.
ALLOWED_ORIGINS="https://jnibarger01.github.io"

# Optional. Secondary RentCast surface at /api/provider/*. Never expose as VITE_*.
RENTCAST_API_KEY=""
PROVIDER_CACHE_TTL_MS="300000"

# Optional Gemini insights on POST /api/market-insights. Server-side only.
GEMINI_API_KEY=""

# Optional legacy upstream MCP. Server-side only. Never returned to the browser.
ZILLOW_MCP_SERVER_URL=""

# Explicit local explorer fixtures only. Never enable in production/Pages.
VITE_ALLOW_FIXTURE_ADAPTER=""

# Optional licensed MLS / RESO operator tools.
BRIDGE_RESO_BASE_URL=""
BRIDGE_RESO_ACCESS_TOKEN=""
RESO_SYNC_TOKEN=""

PG_POOL_MAX="10"

# Per-principal rate limits (session user / Basic identity / API key; else IP).
# Window is 60s. Structured 429: { success:false, error:"rate_limit_exceeded", ... }.
API_RATE_LIMIT_PER_MINUTE="60"
# Tighter bucket for /api/properties/* and /api/map/* (owner-PII / search-heavy).
PII_RATE_LIMIT_PER_MINUTE="30"

# Optional dashboard SPA session (httpOnly cookie). Defaults: 30m TTL, warn at 10%/60s.
SESSION_TTL_MS="1800000"
SESSION_IDLE_WARNING_MS="60000"
# Optional. Derived from dashboard auth material when unset.
SESSION_SECRET=""

# Ingest freshness SLA (hours). Badge warns when api.ingest_state is older.
# Prefer INGEST_SLA_HOURS; INGEST_MAX_AGE_HOURS is an alias. 0 disables the SLA.
INGEST_SLA_HOURS="168"

# Dashboard MCP JSON-RPC at POST /mcp and POST /api/mcp.
# Non-production: enabled by default. Production: set true to expose; false/off disables (404).
# Tools are read-only aggregates only (dashboard_readonly); no owner PII. See docs/MCP.md.
ENABLE_MCP=""

