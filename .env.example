# GEMINI_API_KEY: Optional. Used only by the original full-stack server for AI market insights.
GEMINI_API_KEY=""

# RENTCAST_API_KEY: Required by backend.ts for live property/listing/public-record data.
# Keep this server-side only. Never expose it as a VITE_* variable or GitHub Pages secret.
RENTCAST_API_KEY=""

# ALLOWED_ORIGINS: Optional comma-separated browser origins allowed to call backend.ts.
# The GitHub Pages origin and localhost development origins are allowed by default.
ALLOWED_ORIGINS="https://jnibarger01.github.io"

# VITE_API_BASE_URL: Public HTTPS URL of the deployed backend, without a trailing slash.
# Example: https://kc-real-estate-api.onrender.com
# This value is safe to publish because it is an API URL, not a credential.
VITE_API_BASE_URL=""

# APP_URL: Optional public application URL used by the original full-stack deployment.
APP_URL=""

# ZILLOW_MCP_SERVER_URL: Optional legacy external MCP endpoint used by server.ts.
ZILLOW_MCP_SERVER_URL=""

# Bridge RESO / MLS sync: keep all three values server-side. The public API never
# exposes the sync operation. A PostgreSQL persistence adapter is still required
# before POST /api/reso/sync can be enabled.
BRIDGE_RESO_BASE_URL=""
BRIDGE_RESO_ACCESS_TOKEN=""
RESO_SYNC_TOKEN=""

# DATABASE_URL: PostgreSQL/PostGIS connection used by the dashboard API.
# Local peer-auth default:
# postgresql://jacen@/jacen_dev?host=/var/run/postgresql
DATABASE_URL=""

# Optional HTTP Basic Auth for the dashboard and dashboard API.
# Configure both together. Use HTTPS when exposed beyond localhost.
DASHBOARD_AUTH_USER=""
DASHBOARD_AUTH_PASSWORD=""
