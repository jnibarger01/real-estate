{
  "name": "jackson-county-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:backend": "tsx backend.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --sources-content=false --outfile=dist/server.js",
    "build:backend": "esbuild backend.ts --bundle --platform=node --format=esm --packages=external --sourcemap --sources-content=false --outfile=dist/backend.js",
    "build:pages": "vite build --mode pages --base=/real-estate/",
    "check:pages-split": "bash scripts/check-pages-auth-split.sh",
    "start": "node dist/server.js",
    "start:backend": "node dist/backend.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run && tsx --test --test-timeout=120000 tests/api.integration.test.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:contract": "bin/create-dashboard-contract.sh",
    "test:watch": "vitest",
    "db:views": "psql -d jacen_dev -v ON_ERROR_STOP=1 -f sql/api_dashboard_views.sql && psql -d jacen_dev -v ON_ERROR_STOP=1 -f sql/api_saved_searches.sql",
    "db:indexes": "psql -d jacen_dev -v ON_ERROR_STOP=1 -f sql/spatial_indexes.sql",
    "db:promote": "psql -d jacen_dev -v ON_ERROR_STOP=1 -f sql/promote_raw_to_mart.sql",
    "db:refresh": "db/refresh_materialized.sh",
    "db:backup": "scripts/backup-postgres.sh",
    "ops:health": "scripts/check-health.sh",
    "ops:loadtest": "node scripts/loadtest-search.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.2.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^6.4.3",
    "zod": "^4.6.4",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "8",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "maplibre-gl": "^6.9.0",
    "pg": "^8.23.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.25",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.0",
    "esbuild": "^0.25.12",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
}
